generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum ResponsibilityType {
  COE
  DEAN
  COORDINATOR
  MODERATOR
  CONTRIBUTOR
}

enum ScopeType {
  INSTITUTION
  DEPARTMENT
  QUESTION_BANK
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum ExamType {
  ISE_1
  ISE_2
  ENDSEM
  SUPPLEMENTARY
  KT
}

enum ExamCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum QuestionBankPhase {
  DRAFTING
  MODERATION
  APPROVAL
  COMPLETE
}

enum RecordStatus {
  ACTIVE
  LOCKED
}

enum SnapshotType {
  LOCKED
}

enum AiReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaperGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaperVariant {
  PAPER_A
  PAPER_B
  PAPER_C
}

enum CoordinatorDecision {
  APPROVED
  REJECTED
}

enum ExportFormat {
  PDF
  DOCX
  ZIP
}

enum ExportArtifactStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION_REQUIRED
}

enum CourseOutcome {
  CO1
  CO2
  CO3
  CO4
  CO5
  CO6
}

enum RbtLevel {
  L1
  L2
  L3
  L4
  L5
  L6
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
  REVISION_SUBMITTED
}

enum AcademicYearStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum SubjectVersionStatus {
  ACTIVE
  ARCHIVED
}

enum GroupAssignment {
  ALL
  GROUP_1
  GROUP_2
}

enum BatchStatus {
  ACTIVE
  GRADUATED
}

enum BatchSemesterStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum AnalysisStatus {
  INITIALIZED
  EXTRACTING
  COMPUTING
  AI_PENDING
  AI_COMPLETE
  COMPLETE
  FAILED
}

enum Classification {
  EXEMPLARY
  HIGHLY_EFFECTIVE
  EFFECTIVE
  ACCEPTABLE
  NEEDS_IMPROVEMENT
  MAJOR_REVISION_REQUIRED
}

enum ConfidenceClassification {
  VERY_HIGH
  HIGH
  MEDIUM
  LOW
  VERY_LOW
}

enum EvidenceType {
  DIRECT
  METADATA
  CALCULATED
  PROFESSIONAL_JUDGEMENT
  UNSUPPORTED
}

enum FinalVerdict {
  APPROVED_WITHOUT_MODIFICATION
  APPROVED_WITH_MINOR_IMPROVEMENTS
  APPROVED_SUBJECT_TO_REVISION
  MAJOR_REVISION_REQUIRED
  NOT_APPROVED
}

enum IndexCode {
  SCI
  MII
  BDI
  CVI
  MCAI
  DBI
  QCQI
  CAI
  AMI
  FRI
  QPQI
  OCI
  ECS
  EQI
  COA
  POA
  PIA
  RBTA
  DA
  MAA
  QTA
  MC
  MCS
  LOTS
  HOTS
  CBR
}

enum PromptModuleId {
  EXECUTIVE_SUMMARY
  BLOOM_ANALYSIS
  DIFFICULTY_ANALYSIS
  CO_COVERAGE
  MODULE_COVERAGE
  CONCEPT_DIVERSITY
  RISK_ANALYSIS
  RECOMMENDATIONS
  ACADEMIC_QUALITY
  FINAL_VERDICT
  SYSTEM_PREAMBLE
}

enum RiskPriority {
  CRITICAL
  MAJOR
  MODERATE
  MINOR
}

enum RiskType {
  EDUCATIONAL
  INSTITUTIONAL
  ASSESSMENT
  ACCREDITATION
}

model AcademicYear {
  id              String             @id @default(cuid())
  code            String             @unique
  startDate       DateTime?
  endDate         DateTime?
  status          AcademicYearStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  subjectVersions SubjectVersion[]   @relation("subjectVersionAcademicYear")
  batchSemesters  BatchSemester[]
  questionBanks   QuestionBank[]
}

model SubjectVersion {
  id                          String                @id @default(cuid())
  subjectId                   String
  versionNumber               Int
  title                       String
  syllabusDescription         String?
  effectiveFromAcademicYearId String
  status                      SubjectVersionStatus  @default(ACTIVE)
  createdAt                   DateTime              @default(now())
  updatedAt                   DateTime              @updatedAt
  subject                     Subject               @relation(fields: [subjectId], references: [id])
  effectiveFromAcademicYear   AcademicYear          @relation("subjectVersionAcademicYear", fields: [effectiveFromAcademicYearId], references: [id])
  libraryItems                QuestionLibraryItem[]

  @@unique([subjectId, versionNumber])
  @@index([subjectId, status])
}

model Department {
  id                  String              @id @default(cuid())
  name                String
  code                String              @unique
  hodName             String
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  homeDepartmentUsers User[]              @relation("UserHomeDepartment")
  subjects            Subject[]
  curriculumSchemes   CurriculumScheme[]
  batches             Batch[]
  curriculumSubjects  CurriculumSubject[]
  batchSemesters      BatchSemester[]     @relation("batchSemesterAcademicUnit")
}

model User {
  id                          String                     @id @default(cuid())
  name                        String
  email                       String                     @unique
  passwordHash                String
  status                      UserStatus                 @default(ACTIVE)
  lastLoginAt                 DateTime?
  homeDepartmentId            String?
  resetTokenHash              String?
  resetTokenExpiry            DateTime?
  createdAt                   DateTime                   @default(now())
  updatedAt                   DateTime                   @updatedAt
  homeDepartment              Department?                @relation("UserHomeDepartment", fields: [homeDepartmentId], references: [id])
  responsibilities            ResponsibilityAssignment[]
  notifications               Notification[]
  auditLogs                   AuditLog[]
  questionBanks               QuestionBank[]             @relation("questionBankCreator")
  createdQuestions            QuestionLibraryItem[]      @relation("questionCreator")
  ownedQuestions              QuestionLibraryItem[]      @relation("questionOwner")
  moderationEvents            ModerationEvent[]          @relation("moderationEventActor")
  revisionChanges             QuestionRevision[]         @relation("revisionChangedBy")
  ownershipToUser             QuestionOwnershipHistory[] @relation("ownershipToUser")
  ownershipFromUser           QuestionOwnershipHistory[] @relation("ownershipFromUser")
  ownershipTransferredBy      QuestionOwnershipHistory[] @relation("ownershipTransferredBy")
  deanReviews                 DeanReview[]               @relation("deanReviewSelector")
  slotReservations            QuestionSlot[]
  approvalDecisionsCreated    ApprovalDecision[]
  exportArtifacts             ExportArtifact[]           @relation("exportArtifactGenerator")
  backupsTriggered            SystemBackup[]             @relation("backupTrigger")
  emergencyApprovalsRequested EmergencyApproval[]        @relation("emergencyApprovalRequestedBy")
  emergencyApprovalsApproved  EmergencyApproval[]        @relation("emergencyApprovalApprovedBy")
  analysisTriggers            QuestionBankAnalysis[]     @relation("analysisTriggeredBy")

  @@index([homeDepartmentId])
}

model ExamCycle {
  id                   String          @id @default(cuid())
  examType             ExamType
  status               ExamCycleStatus @default(DRAFT)
  version              Int             @default(0)
  startDate            DateTime?
  endDate              DateTime?
  batchSemesterId      String
  timetableDocumentRef String?
  timetableIssueDate   DateTime?
  timetableTitle       String?

  timetableRows        Json?
  timetableSignature   String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  batchSemester        BatchSemester          @relation(fields: [batchSemesterId], references: [id])
  subjectLinks         SubjectExamCycleLink[]
  questionUsageHistory QuestionUsageHistory[] @relation("usageHistoryExamCycle")

  @@unique([batchSemesterId, examType])
  @@index([batchSemesterId])
}

model Subject {
  id                  String                 @id @default(cuid())
  subjectCode         String
  subjectName         String
  credits             Int
  status              SubjectStatus          @default(ACTIVE)
  questionBankDueDate DateTime
  departmentId        String
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  department          Department             @relation(fields: [departmentId], references: [id])
  examCycleLinks      SubjectExamCycleLink[]
  questionBanks       QuestionBank[]
  versions            SubjectVersion[]
  curriculumSubjects  CurriculumSubject[]

  @@unique([subjectCode, departmentId])
  @@index([departmentId])
}

model QuestionBank {
  id              String            @id @default(cuid())
  subjectId       String
  batchSemesterId String
  academicYearId  String
  phase           QuestionBankPhase @default(DRAFTING)
  recordStatus    RecordStatus      @default(ACTIVE)
  version         Int               @default(0)
  createdById     String
  lockedAt        DateTime?
  lockedReason    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  subject       Subject       @relation(fields: [subjectId], references: [id])
  batchSemester BatchSemester @relation(fields: [batchSemesterId], references: [id])
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id])
  createdBy     User          @relation("questionBankCreator", fields: [createdById], references: [id])

  aiReports       AiReport[]
  generatedPapers GeneratedPaper[]
  deanReview      DeanReview?
  exportArtifacts ExportArtifact[]

  slots                QuestionSlot[]
  pattern              PaperPattern?
  snapshots            QuestionBankSnapshot[]
  paperSnapshots       PaperSnapshot[]
  approvalDecisions    ApprovalDecision[]
  questionBankAnalyses QuestionBankAnalysis[]

  @@unique([batchSemesterId, subjectId])
  @@index([subjectId])
  @@index([phase, recordStatus])
  @@index([batchSemesterId])
}

model QuestionLibraryItem {
  id                  String                     @id @default(cuid())
  subjectVersionId    String
  moduleNumber        Int
  marks               Int
  questionText        String                     @db.Text
  coMapping           CourseOutcome
  rbtLevel            RbtLevel
  difficultyLevel     DifficultyLevel?
  teachingIndex       String?
  status              QuestionStatus             @default(DRAFT)
  createdById         String
  ownerId             String
  moderatorRemark     String?
  submittedAt         DateTime?
  reviewedAt          DateTime?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt
  subjectVersion      SubjectVersion             @relation(fields: [subjectVersionId], references: [id])
  creator             User                       @relation("questionCreator", fields: [createdById], references: [id])
  owner               User                       @relation("questionOwner", fields: [ownerId], references: [id])
  moderationEvents    ModerationEvent[]
  generatedPaperItems GeneratedPaperItem[]
  revisionHistory     QuestionRevision[]
  slotAssignments     QuestionSlot[]
  ownershipHistory    QuestionOwnershipHistory[]
  usageHistory        QuestionUsageHistory[]

  @@index([subjectVersionId, moduleNumber, marks])
  @@index([createdById, status])
  @@index([ownerId])
  @@index([status])
}

model QuestionOwnershipHistory {
  id              String              @id @default(cuid())
  questionId      String
  fromUserId      String
  toUserId        String
  transferredById String
  reason          String?
  transferredAt   DateTime            @default(now())
  question        QuestionLibraryItem @relation(fields: [questionId], references: [id], onDelete: Cascade)
  fromUser        User                @relation("ownershipFromUser", fields: [fromUserId], references: [id])
  toUser          User                @relation("ownershipToUser", fields: [toUserId], references: [id])
  transferredBy   User                @relation("ownershipTransferredBy", fields: [transferredById], references: [id])

  @@index([questionId, transferredAt])
}

model QuestionRevision {
  id                    String              @id @default(cuid())
  questionId            String
  revisionNumber        Int
  snapshotQuestionText  String              @db.Text
  snapshotModule        Int
  snapshotMarks         Int
  snapshotCo            CourseOutcome
  snapshotRbt           RbtLevel
  snapshotDifficulty    DifficultyLevel?
  snapshotTeachingIndex String?
  changedById           String
  changeReason          String?
  createdAt             DateTime            @default(now())
  question              QuestionLibraryItem @relation(fields: [questionId], references: [id], onDelete: Cascade)
  changedBy             User                @relation("revisionChangedBy", fields: [changedById], references: [id])

  @@unique([questionId, revisionNumber])
  @@index([questionId, createdAt])
}

model QuestionUsageHistory {
  id          String              @id @default(cuid())
  questionId  String
  sourceType  String // "GENERATED_PAPER" | "MANUAL" | "EXPORT"
  sourceId    String
  examCycleId String?
  usedAt      DateTime            @default(now())
  question    QuestionLibraryItem @relation(fields: [questionId], references: [id], onDelete: Cascade)
  examCycle   ExamCycle?          @relation("usageHistoryExamCycle", fields: [examCycleId], references: [id])

  @@index([questionId, usedAt])
  @@index([sourceType, sourceId])
}

// A QuestionSlot links a QuestionLibraryItem to a specific position within a QuestionBank.
// A QuestionLibraryItem MAY be assigned to slots in multiple different banks simultaneously,
// but within a single bank it can only occupy ONE slot.
// This is enforced at the app layer (via conflict detection in createForBank).
// MySQL does not support partial/filtered unique indexes in Prisma,
// so a DB-level unique constraint on (questionBankId, assignedQuestionId)
// would prevent cross-bank assignments, which we do NOT want.
// Keep: app-layer enforcement + @@index for query performance.
model QuestionSlot {
  id                 String    @id @default(cuid())
  questionBankId     String
  moduleNumber       Int
  marks              Int
  slotNumber         Int
  assignedQuestionId String?
  reservedById       String?
  reservedAt         DateTime?
  isLocked           Boolean   @default(false)

  questionBank     QuestionBank         @relation(fields: [questionBankId], references: [id])
  assignedQuestion QuestionLibraryItem? @relation(fields: [assignedQuestionId], references: [id])
  reservedBy       User?                @relation(fields: [reservedById], references: [id])

  @@unique([questionBankId, moduleNumber, marks, slotNumber])
  @@index([questionBankId, assignedQuestionId])
  @@index([assignedQuestionId])
}

model PaperPattern {
  id             String       @id @default(cuid())
  questionBankId String       @unique
  examType       ExamType
  totalModules   Int
  marksPattern   Json
  slotsPerModule Int
  totalSlots     Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id])
}

model ApprovalDecision {
  id             String              @id @default(cuid())
  questionBankId String
  decision       CoordinatorDecision
  remark         String?
  decidedById    String
  decidedAt      DateTime            @default(now())

  questionBank QuestionBank @relation(fields: [questionBankId], references: [id])
  decidedBy    User         @relation(fields: [decidedById], references: [id])

  @@unique([questionBankId])
  @@index([questionBankId])
}

model QuestionBankSnapshot {
  id              String            @id @default(cuid())
  questionBankId  String
  snapshotType    SnapshotType
  phase           QuestionBankPhase
  status          RecordStatus
  slotAssignments Json
  version         Int
  createdAt       DateTime          @default(now())

  questionBank QuestionBank @relation(fields: [questionBankId], references: [id], onDelete: Cascade)

  @@index([questionBankId, snapshotType, createdAt])
}

model PaperSnapshot {
  id              String       @id @default(cuid())
  questionBankId  String
  variant         PaperVariant
  paperJson       Json
  coverageScore   Float?
  difficultyScore Float?
  qualityScore    Float?
  createdAt       DateTime     @default(now())

  questionBank QuestionBank @relation(fields: [questionBankId], references: [id])

  @@unique([questionBankId, variant])
}

model ResponsibilityAssignment {
  id             String             @id @default(cuid())
  userId         String
  responsibility ResponsibilityType
  scopeType      ScopeType
  scopeId        String? // Department.id or QuestionBank.id (app-validated)
  activeFrom     DateTime           @default(now())
  activeTo       DateTime?
  assignedById   String? // User who created this assignment
  assignedAt     DateTime           @default(now())
  deletedAt      DateTime? // Soft-delete: set when revoked
  deletedById    String? // User who revoked this assignment
  deletionReason String? // Why it was revoked
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, responsibility, scopeType, scopeId])
  @@index([userId])
  @@index([responsibility, scopeType, scopeId])
  @@index([activeTo])
  @@index([deletedAt])
}

model SubjectExamCycleLink {
  id          String    @id @default(cuid())
  subjectId   String
  examCycleId String
  linkedAt    DateTime  @default(now())
  subject     Subject   @relation(fields: [subjectId], references: [id])
  examCycle   ExamCycle @relation(fields: [examCycleId], references: [id])

  @@unique([subjectId, examCycleId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean          @default(false)
  actionUrl   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  recipient   User             @relation(fields: [recipientId], references: [id])

  @@index([recipientId, isRead, createdAt])
}

/// SHA-256 hash-chained immutable audit log.
/// The previousHash → integrityHash chain forms a tamper-evident linked list.
/// A UNIQUE constraint on previousHash prevents undetected chain forks.
model AuditLog {
  id              String   @id @default(cuid())
  actorId         String?
  action          String
  entityType      String
  entityId        String?
  metadata        Json?
  ipAddress       String?
  userAgent       String?
  sessionId       String?
  securityEventId String?
  previousHash    String?  @unique
  integrityHash   String?
  createdAt       DateTime @default(now())
  actor           User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
  @@index([actorId, action, createdAt])
}

/// One-time password for step-up authentication.
/// Codes are bound to user + action + resource (paper/operation) + session.
/// Hashed with bcrypt before storage. Single-use via atomic UPDATE.
model OtpCode {
  id                 String    @id @default(cuid())
  userId             String
  purpose            String // "DEAN_REVEAL" | "DEAN_APPROVE" | "COE_DOWNLOAD" | "COE_MARK_USED" | "COE_ARCHIVE" | "COE_EXPORT"
  resourceId         String? // Paper ID or QuestionBank ID this OTP authorizes
  sessionId          String? // JTI of the session that requested the OTP
  browserFingerprint String? // SHA-256 hash of UA + Accept-Language + platform
  codeHash           String // bcrypt hash of the 6-digit code
  expiresAt          DateTime
  attemptCount       Int       @default(0)
  securityEventId    String?
  usedAt             DateTime?
  createdAt          DateTime  @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

/// Runtime security configuration overrides.
/// Bootstrap via SECURITY_MODE env var, overridden at runtime via this table.
/// Every change is audited via AuditLog where entityType = "SECURITY_CONFIG".
model SecurityConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())
}

/// Tracks paper downloads for forensic tracing.
/// Each download receives a unique Download UUID embedded in the DOCX.
model PaperDownload {
  id              String   @id @default(cuid())
  downloadId      String   @unique // UUIDv4 — embedded in DOCX watermark
  paperId         String
  variant         String
  downloadedById  String
  downloadedAt    DateTime @default(now())
  ipAddress       String?
  userAgent       String?
  sessionId       String?
  auditLogId      String? // Link to the AuditLog entry
  downloadReason  String? // EXAM_PRINTING | QUALITY_REVIEW | ARCHIVE | OTHER
  securityEventId String? // Correlation ID linking OTP flow → download

  @@index([paperId, downloadedAt])
  @@index([downloadId])
  @@index([securityEventId])
}

/// Two-person approval workflow for emergency security actions.
/// Requires 2 distinct COE users to approve before execution.
model EmergencyApproval {
  id            String    @id @default(cuid())
  action        String // "DISABLE_LOCKDOWN" | "ENABLE_DOWNLOADS" | "EMERGENCY_OVERRIDE"
  targetUserId  String?
  reason        String
  requestedById String
  requestedAt   DateTime  @default(now())
  approvedById  String?
  approvedAt    DateTime?
  status        String    @default("PENDING") // PENDING | APPROVED | REJECTED | EXPIRED
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  requestedBy User  @relation("emergencyApprovalRequestedBy", fields: [requestedById], references: [id])
  approvedBy  User? @relation("emergencyApprovalApprovedBy", fields: [approvedById], references: [id])

  @@index([status, expiresAt])
}

model FileAsset {
  id                  String           @id @default(cuid())
  bucket              String
  objectKey           String           @unique
  fileName            String
  mimeType            String
  size                Int
  uploadedById        String?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt
  aiReportsJson       AiReport[]       @relation("aiReportJsonAsset")
  aiReportsPdf        AiReport[]       @relation("aiReportPdfAsset")
  generatedPaperFiles GeneratedPaper[] @relation("generatedPaperFileAsset")
  exportArtifacts     ExportArtifact[] @relation("exportArtifactFileAsset")
  systemBackups       SystemBackup[]   @relation("systemBackupFileAsset")
}

model ModerationEvent {
  id          String              @id @default(cuid())
  questionId  String
  moderatorId String
  action      String
  note        String?
  createdAt   DateTime            @default(now())
  question    QuestionLibraryItem @relation(fields: [questionId], references: [id])
  moderator   User                @relation("moderationEventActor", fields: [moderatorId], references: [id])

  @@index([questionId, createdAt])
  @@index([moderatorId, createdAt])
}

model AiReport {
  id              String         @id @default(cuid())
  questionBankId  String
  status          AiReportStatus @default(PENDING)
  modelName       String
  summary         String?        @db.Text
  reportJson      Json?
  chartData       Json?
  failureReason   String?
  generatedById   String?
  generatedAt     DateTime?
  jsonFileAssetId String?
  pdfFileAssetId  String?
  paperAnalysisId String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  questionBank    QuestionBank   @relation(fields: [questionBankId], references: [id])
  jsonFileAsset   FileAsset?     @relation("aiReportJsonAsset", fields: [jsonFileAssetId], references: [id])
  pdfFileAsset    FileAsset?     @relation("aiReportPdfAsset", fields: [pdfFileAssetId], references: [id])
  paperAnalysis   PaperAnalysis? @relation(fields: [paperAnalysisId], references: [id])

  @@index([questionBankId, status])
}

model GeneratedPaper {
  id               String                @id @default(cuid())
  questionBankId   String
  variant          PaperVariant
  status           PaperGenerationStatus @default(PENDING)
  generatedById    String?
  generatedAt      DateTime?
  failureReason    String?
  paperJson        Json?
  paperFileAssetId String?
  coverageScore    Float?
  difficultyScore  Float?
  qualityScore     Float?
  duplicateRisk    Float?
  recommendation   String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  questionBank     QuestionBank          @relation(fields: [questionBankId], references: [id])
  paperFileAsset   FileAsset?            @relation("generatedPaperFileAsset", fields: [paperFileAssetId], references: [id])
  items            GeneratedPaperItem[]
  paperAnalyses    PaperAnalysis[]

  @@unique([questionBankId, variant])
}

model GeneratedPaperItem {
  id               String              @id @default(cuid())
  generatedPaperId String
  questionId       String
  createdAt        DateTime            @default(now())
  generatedPaper   GeneratedPaper      @relation(fields: [generatedPaperId], references: [id], onDelete: Cascade)
  question         QuestionLibraryItem @relation(fields: [questionId], references: [id])

  @@unique([generatedPaperId, questionId])
}

model DeanReview {
  id                 String       @id @default(cuid())
  questionBankId     String       @unique
  regularPaper       PaperVariant
  supplementaryPaper PaperVariant
  ktPaper            PaperVariant
  reviewedById       String
  notes              String?
  reviewedAt         DateTime     @default(now())
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  questionBank       QuestionBank @relation(fields: [questionBankId], references: [id])
  reviewedBy         User         @relation("deanReviewSelector", fields: [reviewedById], references: [id])
}

model ExportArtifact {
  id             String               @id @default(cuid())
  questionBankId String
  generatedById  String?
  format         ExportFormat
  status         ExportArtifactStatus @default(PENDING)
  fileAssetId    String?
  metadata       Json?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  questionBank   QuestionBank         @relation(fields: [questionBankId], references: [id])
  generatedBy    User?                @relation("exportArtifactGenerator", fields: [generatedById], references: [id])
  fileAsset      FileAsset?           @relation("exportArtifactFileAsset", fields: [fileAssetId], references: [id])

  @@index([questionBankId, format, status])
}

model SystemBackup {
  id            String       @id @default(cuid())
  status        BackupStatus @default(PENDING)
  fileAssetId   String?
  triggeredById String?
  metadata      Json?
  failureReason String?
  expiresAt     DateTime
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  fileAsset     FileAsset?   @relation("systemBackupFileAsset", fields: [fileAssetId], references: [id])
  triggeredBy   User?        @relation("backupTrigger", fields: [triggeredById], references: [id])
}

model RevokedToken {
  id        String   @id @default(cuid())
  jti       String   @unique
  type      String // "access" | "refresh"
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

/// CurriculumScheme defines a named curriculum plan for a Department (e.g. "2025 Scheme").
model CurriculumScheme {
  id                String   @id @default(cuid())
  departmentId      String
  name              String
  year              Int
  durationSemesters Int      @default(8)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  department         Department          @relation(fields: [departmentId], references: [id])
  curriculumSubjects CurriculumSubject[]
  batches            Batch[]

  @@unique([departmentId, year])
}

/// CurriculumSubject is the authoritative mapping of Subject → (Semester, Department, TeachingGroup).
/// This is a pure curriculum entity — it describes what subjects are studied, not operational deadlines.
/// A Subject can appear multiple times across different semesters and group assignments.
model CurriculumSubject {
  id                 String          @id @default(cuid())
  curriculumSchemeId String
  subjectId          String
  semesterNumber     Int // 1-8
  departmentId       String // which department offers this subject in this semester
  groupAssignment    GroupAssignment @default(ALL)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  curriculumScheme CurriculumScheme @relation(fields: [curriculumSchemeId], references: [id])
  subject          Subject          @relation(fields: [subjectId], references: [id])
  department       Department       @relation(fields: [departmentId], references: [id])

  @@unique([curriculumSchemeId, subjectId, semesterNumber, groupAssignment])
  @@index([curriculumSchemeId, semesterNumber, departmentId])
  @@index([subjectId])
}

/// Batch represents an academic cohort (e.g. "BE Computer 2025-29").
/// No student table exists. Batch is a cohort descriptor only.
/// Tracks its own current semester for fast dashboard/reporting access.
model Batch {
  id                     String      @id @default(cuid())
  name                   String
  code                   String      @unique
  departmentId           String
  curriculumSchemeId     String
  admissionYear          Int
  graduationYear         Int
  status                 BatchStatus @default(ACTIVE)
  hasTeachingGroups      Boolean     @default(false)
  currentBatchSemesterId String?
  currentSemesterNumber  Int?
  createdAt              DateTime    @default(now())
  updatedAt              DateTime    @updatedAt

  department           Department       @relation(fields: [departmentId], references: [id])
  curriculumScheme     CurriculumScheme @relation(fields: [curriculumSchemeId], references: [id])
  currentBatchSemester BatchSemester?   @relation("BatchToBatchSemesterCurrent", fields: [currentBatchSemesterId], references: [id])

  batchSemesters BatchSemester[]
  teachingGroups TeachingGroup[]

  @@index([currentBatchSemesterId])
}

/// BatchSemester is a per-batch instance of a semester (batch's semester 5, not a global one).
/// Each batch owns its own schedule with independent start/end dates.
/// The COE sets dates manually — no assumptions about a college calendar.
/// Always belongs to an AcademicYear for reporting purposes.
model BatchSemester {
  id             String              @id @default(cuid())
  batchId        String
  semesterNumber Int // 1-8
  academicYearId String
  departmentId   String
  startDate      DateTime?
  endDate        DateTime?
  status         BatchSemesterStatus @default(UPCOMING)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  batch          Batch          @relation(fields: [batchId], references: [id])
  batchCurrentOf Batch[]        @relation("BatchToBatchSemesterCurrent")
  academicYear   AcademicYear   @relation(fields: [academicYearId], references: [id])
  department     Department     @relation("batchSemesterAcademicUnit", fields: [departmentId], references: [id])
  examCycles     ExamCycle[]
  questionBanks  QuestionBank[]

  @@unique([batchId, semesterNumber])
  @@index([academicYearId])
  @@index([departmentId])
}

/// TeachingGroup records which teaching groups exist for a batch in first year.
/// Each group has a name (e.g. "Physics Group") and belongs to a batch.
/// Maximum 2 groups per batch. Subject-to-group mapping is on CurriculumSubject,
/// NOT on this entity.
model TeachingGroup {
  id          String   @id @default(cuid())
  batchId     String
  groupNumber Int // 1 or 2
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  batch Batch @relation(fields: [batchId], references: [id])

  @@unique([batchId, groupNumber])
}

// ═══════════════════════════════════════════════════════════════
// UAF AI Analysis Models
// ═══════════════════════════════════════════════════════════════

/// Root aggregate for one complete UAF evaluation of a QuestionBank.
model QuestionBankAnalysis {
  id             String         @id @default(cuid())
  questionBankId String
  version        Int            @default(1)
  status         AnalysisStatus @default(INITIALIZED)
  triggeredById  String?
  startedAt      DateTime?
  completedAt    DateTime?

  // Version metadata (for reproducibility)
  evaluationEngineVersion String?
  analysisSchemaVersion   String?
  ollamaModel             String?
  ollamaContext           Int?
  ollamaTemperature       Float?

  // Results
  qpqi                   Float?
  qpqiClassification     Classification?
  oci                    Float?
  ociClassification      ConfidenceClassification?
  finalVerdict           FinalVerdict?
  executiveSummary       String?                   @db.Text
  accreditationReadiness Json?

  // Error tracking
  failureReason String?
  errorDetails  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  questionBank QuestionBank @relation(fields: [questionBankId], references: [id])
  triggeredBy  User?        @relation("analysisTriggeredBy", fields: [triggeredById], references: [id])

  // Child collections
  versions        AnalysisVersion[]
  metrics         UAFMetric[]
  risks           Risk[]
  recommendations Recommendation[]
  evidenceItems   AnalysisEvidence[]
  paperAnalyses   PaperAnalysis[]

  @@unique([questionBankId, version])
  @@index([questionBankId, status])
  @@index([questionBankId, createdAt])
}

/// Immutable version record for a single analysis run.
model AnalysisVersion {
  id                      String   @id @default(cuid())
  questionBankAnalysisId  String
  versionNumber           Int
  evaluationEngineVersion String
  promptVersionString     String?
  analysisSchemaVersion   String
  ollamaModel             String?
  ollamaContext           Int?
  ollamaTemperature       Float?
  evidenceHash            String?
  promptVersionId         String?
  createdAt               DateTime @default(now())

  // Relations
  questionBankAnalysis QuestionBankAnalysis @relation(fields: [questionBankAnalysisId], references: [id], onDelete: Cascade)
  promptVersion        PromptVersion?       @relation(fields: [promptVersionId], references: [id])
  evidenceSnapshot     EvidenceSnapshot?
  analysisSnapshot     AnalysisSnapshot?

  @@unique([questionBankAnalysisId, versionNumber])
  @@index([questionBankAnalysisId, versionNumber])
  @@index([evidenceHash])
}

/// The exact deterministic evidence package sent to Ollama. Persisted for reproducibility.
model EvidenceSnapshot {
  id                          String   @id @default(cuid())
  analysisVersionId           String   @unique
  totalQuestions              Int
  verifiedQuestions           Int
  unableToVerifyQuestions     Int
  missingDataQuestions        Int
  extractionCompletenessScore Float?
  extractionQualityIndex      Float?
  evidenceSummary             Json?
  sourceDataSnapshot          Json?
  evidenceHash                String?
  sizeBytes                   Int?
  createdAt                   DateTime @default(now())

  // Relations
  analysisVersion AnalysisVersion @relation(fields: [analysisVersionId], references: [id], onDelete: Cascade)
}

/// Point-in-time snapshot of a completed analysis — the read model for the Dean's UI.
model AnalysisSnapshot {
  id                  String   @id @default(cuid())
  analysisVersionId   String   @unique
  fullReport          Json? // All 15 phases output
  strengths           Json? // Top 5 institutional strengths
  weaknesses          Json? // Top 5 institutional weaknesses
  recommendationsJson Json? // Full recommendation register
  createdAt           DateTime @default(now())

  // Relations
  analysisVersion AnalysisVersion @relation(fields: [analysisVersionId], references: [id], onDelete: Cascade)
}

/// UAF analysis scoped to a single GeneratedPaper (variant A/B/C).
model PaperAnalysis {
  id                     String   @id @default(cuid())
  questionBankAnalysisId String
  generatedPaperId       String
  indexValues            Json? // Per-paper index values
  aiNarrative            Json? // Per-paper AI narrative
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  // Relations
  questionBankAnalysis QuestionBankAnalysis @relation(fields: [questionBankAnalysisId], references: [id], onDelete: Cascade)
  generatedPaper       GeneratedPaper       @relation(fields: [generatedPaperId], references: [id])
  aiReports            AiReport[]

  @@unique([questionBankAnalysisId, generatedPaperId])
  @@index([questionBankAnalysisId])
  @@index([generatedPaperId])
}

/// One computed index or sub-metric. Immutable after computation.
model UAFMetric {
  id                     String          @id @default(cuid())
  questionBankAnalysisId String
  indexCode              IndexCode
  value                  Float? // 0.00-1.00 or null on failure
  classification         Classification?
  weight                 Float? // For QPQI composition
  weightedScore          Float?
  formulaUsed            String?
  computationOrder       Int?
  notes                  String?         @db.Text
  createdAt              DateTime        @default(now())

  // Relations
  questionBankAnalysis QuestionBankAnalysis @relation(fields: [questionBankAnalysisId], references: [id], onDelete: Cascade)
  confidence           ConfidenceScore?

  @@unique([questionBankAnalysisId, indexCode])
  @@index([questionBankAnalysisId, indexCode])
  @@index([indexCode, value])
}

/// Confidence associated with a UAFMetric.
model ConfidenceScore {
  id             String                   @id @default(cuid())
  uafMetricId    String                   @unique
  verifiedItems  Int
  requiredItems  Int
  score          Float
  percentage     Float
  classification ConfidenceClassification
  justification  String?                  @db.Text
  createdAt      DateTime                 @default(now())

  // Relations
  uafMetric UAFMetric @relation(fields: [uafMetricId], references: [id], onDelete: Cascade)
}

/// One risk entry from the risk register.
model Risk {
  id                     String       @id @default(cuid())
  questionBankAnalysisId String
  finding                String       @db.Text
  educationalRisk        String?      @db.Text
  institutionalRisk      String?      @db.Text
  priority               RiskPriority
  riskType               RiskType?
  affectedModules        Json?
  affectedCOs            Json?
  evidenceReference      String?
  createdAt              DateTime     @default(now())

  // Relations
  questionBankAnalysis QuestionBankAnalysis @relation(fields: [questionBankAnalysisId], references: [id], onDelete: Cascade)

  @@index([questionBankAnalysisId, priority])
  @@index([questionBankAnalysisId, riskType])
}

/// One recommendation from the recommendation register.
model Recommendation {
  id                     String       @id @default(cuid())
  questionBankAnalysisId String
  finding                String       @db.Text
  recommendation         String       @db.Text
  priority               RiskPriority
  impact                 String?      @db.Text
  suggestedActions       Json?
  evidenceReference      String?
  createdAt              DateTime     @default(now())

  // Relations
  questionBankAnalysis QuestionBankAnalysis @relation(fields: [questionBankAnalysisId], references: [id], onDelete: Cascade)

  @@index([questionBankAnalysisId, priority])
}

/// One piece of evidence available during analysis.
model AnalysisEvidence {
  id                     String       @id @default(cuid())
  questionBankAnalysisId String
  evidenceType           EvidenceType
  level                  Int
  category               String?
  description            String?      @db.Text
  sourceReference        String?
  createdAt              DateTime     @default(now())

  // Relations
  questionBankAnalysis QuestionBankAnalysis @relation(fields: [questionBankAnalysisId], references: [id], onDelete: Cascade)

  @@index([questionBankAnalysisId, evidenceType])
}

/// Immutable record of a prompt version used for AI analysis.
model PromptVersion {
  id            String         @id @default(cuid())
  moduleId      PromptModuleId
  version       Int
  promptText    String         @db.Text
  outputSchema  Json?
  contextBudget Int?
  createdAt     DateTime       @default(now())
  supersededAt  DateTime?

  // Relations
  analysisVersions AnalysisVersion[]

  @@unique([moduleId, version])
  @@index([moduleId, supersededAt])
}
