generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  COE
  COORDINATOR
  MODERATOR
  CONTRIBUTOR
  DEAN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ExamType {
  ISE_1
  ISE_2
  ENDSEM
  SUPPLEMENTARY
  KT
}

enum ExamCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum QuestionBankStatus {
  DRAFT
  IN_PROGRESS
  UNDER_MODERATION
  MODERATED
  REPORT_GENERATED
  AWAITING_HOD_SIGN
  SIGNED_REPORT_UPLOADED
  AWAITING_COORDINATOR_APPROVAL
  APPROVED
  LOCKED
}

enum AiReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaperGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaperVariant {
  PAPER_A
  PAPER_B
  PAPER_C
}

enum CoordinatorDecision {
  APPROVED
  REJECTED
}

enum ExportFormat {
  PDF
  DOCX
  ZIP
}

enum ExportArtifactStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum AssignmentRole {
  MODERATOR
  CONTRIBUTOR
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION_REQUIRED
}

enum CourseOutcome {
  CO1
  CO2
  CO3
  CO4
  CO5
  CO6
}

enum RbtLevel {
  L1
  L2
  L3
  L4
  L5
  L6
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  REVISION_REQUESTED
}

model Department {
  id           String    @id @default(cuid())
  name         String
  code         String    @unique
  hodName      String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  users        User[]
  subjects     Subject[]
  examCycles   ExamCycle[]
}

model User {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  passwordHash     String
  role             Role
  status           UserStatus          @default(ACTIVE)
  lastLoginAt      DateTime?
  departmentId     String?
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  department       Department?         @relation(fields: [departmentId], references: [id])
  assignments      TeacherAssignment[] @relation("assignedTeacher")
  assignedBy       TeacherAssignment[] @relation("assignedBy")
  notifications    Notification[]
  auditLogs        AuditLog[]
  questionBanks    QuestionBank[]      @relation("questionBankCreator")
  questionSlots    QuestionSlot[]      @relation("slotReservedBy")
  contributedQuestions Question[]      @relation("questionContributor")
  uploadedAttachments QuestionAttachment[] @relation("attachmentUploader")
  deanReviews      DeanReview[]        @relation("deanReviewSelector")
  exportArtifacts  ExportArtifact[]    @relation("exportArtifactGenerator")
  backupsTriggered SystemBackup[]      @relation("backupTrigger")
}

model ExamCycle {
  id           String            @id @default(cuid())
  academicYear String
  semester     Int
  examType     ExamType
  status       ExamCycleStatus   @default(DRAFT)
  departmentId String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  department   Department?       @relation(fields: [departmentId], references: [id])
  questionBanks QuestionBank[]

  @@unique([academicYear, semester, examType])
}

model Subject {
  id                  String         @id @default(cuid())
  subjectCode         String         @unique
  subjectName         String
  academicYear        String
  semester            Int
  credits             Int
  questionBankDueDate DateTime
  departmentId        String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  department          Department     @relation(fields: [departmentId], references: [id])
  questionBanks       QuestionBank[]
}

model QuestionBank {
  id           String              @id @default(cuid())
  subjectId    String
  examCycleId  String
  status       QuestionBankStatus  @default(DRAFT)
  createdById  String
  lockedAt     DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  subject      Subject             @relation(fields: [subjectId], references: [id])
  examCycle    ExamCycle           @relation(fields: [examCycleId], references: [id])
  createdBy    User                @relation("questionBankCreator", fields: [createdById], references: [id])
  assignments  TeacherAssignment[]
  questionSlots QuestionSlot[]
  questions    Question[]
  aiReports    AiReport[]
  generatedPapers GeneratedPaper[]
  deanReview   DeanReview?
  signedReportAssetId String?
  signedReportUploadedAt DateTime?
  coordinatorDecision CoordinatorDecision?
  coordinatorReviewedAt DateTime?
  coordinatorReviewRemark String?
  signedReportAsset FileAsset? @relation("questionBankSignedReport", fields: [signedReportAssetId], references: [id])
  exportArtifacts ExportArtifact[]

  @@unique([subjectId, examCycleId])
}

model TeacherAssignment {
  id             String         @id @default(cuid())
  questionBankId String
  teacherId      String
  assignmentRole AssignmentRole
  assignedById   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  questionBank   QuestionBank   @relation(fields: [questionBankId], references: [id])
  teacher        User           @relation("assignedTeacher", fields: [teacherId], references: [id])
  assignedBy     User           @relation("assignedBy", fields: [assignedById], references: [id])

  @@unique([questionBankId, teacherId, assignmentRole])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean          @default(false)
  actionUrl   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  recipient   User             @relation(fields: [recipientId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  previousHash String?
  integrityHash String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id])
}

model FileAsset {
  id               String   @id @default(cuid())
  bucket           String
  objectKey        String   @unique
  fileName         String
  mimeType         String
  size             Int
  uploadedById     String?
  linkedEntityType String?
  linkedEntityId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  attachments      QuestionAttachment[]
  aiReportsJson    AiReport[]      @relation("aiReportJsonAsset")
  aiReportsPdf     AiReport[]      @relation("aiReportPdfAsset")
  generatedPaperFiles GeneratedPaper[] @relation("generatedPaperFileAsset")
  signedQuestionBanks QuestionBank[] @relation("questionBankSignedReport")
  exportArtifacts ExportArtifact[] @relation("exportArtifactFileAsset")
  systemBackups   SystemBackup[]   @relation("systemBackupFileAsset")
}

model QuestionSlot {
  id              String       @id @default(cuid())
  questionBankId  String
  moduleNumber    Int
  marks           Int
  slotNumber      Int
  reservedById    String?
  reservedAt      DateTime?
  isLocked        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  questionBank    QuestionBank @relation(fields: [questionBankId], references: [id])
  reservedBy      User?        @relation("slotReservedBy", fields: [reservedById], references: [id])
  question        Question?

  @@unique([questionBankId, moduleNumber, marks, slotNumber])
}

model Question {
  id              String           @id @default(cuid())
  questionBankId  String
  slotId          String           @unique
  questionText    String
  moduleNumber    Int
  marks           Int
  slotNumber      Int
  coMapping       CourseOutcome
  rbtLevel        RbtLevel
  teachingIndex   String?
  difficultyLevel DifficultyLevel?
  contributorId   String
  status          QuestionStatus   @default(DRAFT)
  moderatorRemark String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  usageCount      Int              @default(0)
  lastUsedExam    String?
  lastUsedYear    String?
  lastUsedSemester Int?
  lastUsedType    ExamType?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questionBank    QuestionBank     @relation(fields: [questionBankId], references: [id])
  slot            QuestionSlot     @relation(fields: [slotId], references: [id])
  contributor     User             @relation("questionContributor", fields: [contributorId], references: [id])
  attachments     QuestionAttachment[]
  generatedPaperItems GeneratedPaperItem[]

  @@index([questionBankId, moduleNumber, marks, slotNumber])
  @@index([contributorId, status])
}

model QuestionAttachment {
  id           String    @id @default(cuid())
  questionId   String
  fileAssetId  String
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  question     Question   @relation(fields: [questionId], references: [id])
  fileAsset    FileAsset  @relation(fields: [fileAssetId], references: [id])
  uploadedBy   User       @relation("attachmentUploader", fields: [uploadedById], references: [id])

  @@unique([questionId, fileAssetId])
}

model AiReport {
  id                 String          @id @default(cuid())
  questionBankId     String
  status             AiReportStatus  @default(PENDING)
  modelName          String
  summary            String?
  reportJson         Json?
  chartData          Json?
  failureReason      String?
  generatedById      String?
  generatedAt        DateTime?
  jsonFileAssetId    String?
  pdfFileAssetId     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  questionBank       QuestionBank    @relation(fields: [questionBankId], references: [id])
  jsonFileAsset      FileAsset?      @relation("aiReportJsonAsset", fields: [jsonFileAssetId], references: [id])
  pdfFileAsset       FileAsset?      @relation("aiReportPdfAsset", fields: [pdfFileAssetId], references: [id])

  @@index([questionBankId, status])
}

model GeneratedPaper {
  id                String                 @id @default(cuid())
  questionBankId    String
  variant           PaperVariant
  status            PaperGenerationStatus  @default(PENDING)
  generatedById     String?
  generatedAt       DateTime?
  failureReason     String?
  paperJson         Json?
  paperFileAssetId  String?
  coverageScore     Float?
  difficultyScore   Float?
  qualityScore      Float?
  duplicateRisk     Float?
  recommendation    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  questionBank      QuestionBank           @relation(fields: [questionBankId], references: [id])
  paperFileAsset    FileAsset?             @relation("generatedPaperFileAsset", fields: [paperFileAssetId], references: [id])
  items             GeneratedPaperItem[]
  selectedAsRegular DeanReview[]           @relation("regularPaper")
  selectedAsSupplementary DeanReview[]     @relation("supplementaryPaper")
  selectedAsKt      DeanReview[]           @relation("ktPaper")

  @@unique([questionBankId, variant])
}

model GeneratedPaperItem {
  id                String         @id @default(cuid())
  generatedPaperId  String
  questionId        String
  createdAt         DateTime       @default(now())
  generatedPaper    GeneratedPaper @relation(fields: [generatedPaperId], references: [id])
  question          Question       @relation(fields: [questionId], references: [id])

  @@unique([generatedPaperId, questionId])
}

model DeanReview {
  id                   String         @id @default(cuid())
  questionBankId       String         @unique
  regularPaperId       String
  supplementaryPaperId String
  ktPaperId            String
  selectedById         String
  notes                String?
  selectedAt           DateTime       @default(now())
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  questionBank         QuestionBank   @relation(fields: [questionBankId], references: [id])
  regularPaper         GeneratedPaper @relation("regularPaper", fields: [regularPaperId], references: [id])
  supplementaryPaper   GeneratedPaper @relation("supplementaryPaper", fields: [supplementaryPaperId], references: [id])
  ktPaper              GeneratedPaper @relation("ktPaper", fields: [ktPaperId], references: [id])
  selectedBy           User           @relation("deanReviewSelector", fields: [selectedById], references: [id])
}

model ExportArtifact {
  id             String               @id @default(cuid())
  questionBankId String
  generatedById  String?
  format         ExportFormat
  status         ExportArtifactStatus @default(PENDING)
  fileAssetId    String?
  metadata       Json?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  questionBank   QuestionBank         @relation(fields: [questionBankId], references: [id])
  generatedBy    User?                @relation("exportArtifactGenerator", fields: [generatedById], references: [id])
  fileAsset      FileAsset?           @relation("exportArtifactFileAsset", fields: [fileAssetId], references: [id])

  @@index([questionBankId, format, status])
}

model SystemBackup {
  id            String       @id @default(cuid())
  status        BackupStatus @default(PENDING)
  fileAssetId   String?
  triggeredById String?
  metadata      Json?
  failureReason String?
  expiresAt     DateTime
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  fileAsset     FileAsset?   @relation("systemBackupFileAsset", fields: [fileAssetId], references: [id])
  triggeredBy   User?        @relation("backupTrigger", fields: [triggeredById], references: [id])
}
