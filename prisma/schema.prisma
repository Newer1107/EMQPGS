generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  COE
  COORDINATOR
  MODERATOR
  CONTRIBUTOR
  DEAN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum ExamType {
  ISE_1
  ISE_2
  ENDSEM
  SUPPLEMENTARY
  KT
}

enum ExamCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum QuestionBankStatus {
  DRAFT
  IN_PROGRESS
  UNDER_MODERATION
  MODERATED
  REPORT_GENERATED
  AWAITING_HOD_SIGN
  SIGNED_REPORT_UPLOADED
  AWAITING_COORDINATOR_APPROVAL
  APPROVED
  LOCKED
}

enum AiReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaperGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaperVariant {
  PAPER_A
  PAPER_B
  PAPER_C
}

enum CoordinatorDecision {
  APPROVED
  REJECTED
}

enum ExportFormat {
  PDF
  DOCX
  ZIP
}

enum ExportArtifactStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum AssignmentRole {
  MODERATOR
  CONTRIBUTOR
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION_REQUIRED
}

enum CourseOutcome {
  CO1
  CO2
  CO3
  CO4
  CO5
  CO6
}

enum RbtLevel {
  L1
  L2
  L3
  L4
  L5
  L6
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
  REVISION_SUBMITTED
}

model Department {
  id           String    @id @default(cuid())
  name         String
  code         String    @unique
  hodName      String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  users        User[]
  coordinatorAssignments CoordinatorDepartmentAssignment[]
  subjects     Subject[]
  examCycles   ExamCycle[]
}

model User {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  passwordHash     String
  role             Role
  status           UserStatus          @default(ACTIVE)
  lastLoginAt      DateTime?
  departmentId     String?
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  department       Department?         @relation(fields: [departmentId], references: [id])
  coordinatorDepartments CoordinatorDepartmentAssignment[] @relation("coordinatorDepartmentUser")
  assignments      TeacherAssignment[] @relation("assignedTeacher")
  assignedBy       TeacherAssignment[] @relation("assignedBy")
  moderatorBankAssignments ModeratorBankAssignment[] @relation("moderatorBankUser")
  notifications    Notification[]
  auditLogs        AuditLog[]
  questionBanks    QuestionBank[]      @relation("questionBankCreator")
  questionSlots    QuestionSlot[]      @relation("slotReservedBy")
  contributedQuestions Question[]      @relation("questionContributor")
  moderationEvents ModerationEvent[]   @relation("moderationEventActor")
  submittedRevisions QuestionRevision[] @relation("revisionSubmitter")
  uploadedAttachments QuestionAttachment[] @relation("attachmentUploader")
  deanReviews      DeanReview[]        @relation("deanReviewSelector")
  exportArtifacts  ExportArtifact[]    @relation("exportArtifactGenerator")
  backupsTriggered SystemBackup[]      @relation("backupTrigger")

  @@index([role])
  @@index([departmentId])
}

model ExamCycle {
  id                    String            @id @default(cuid())
  academicYear          String
  semester              Int
  examType              ExamType
  status                ExamCycleStatus   @default(DRAFT)
  version               Int               @default(0)
  startDate             DateTime?
  endDate               DateTime?
  departmentId          String?
  timetableDocumentRef  String?
  timetableIssueDate    DateTime?
  timetableTitle        String?
  timetableBranch       String?
  timetableRows         Json?
  timetableSignature    String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  department            Department?       @relation(fields: [departmentId], references: [id])
  subjectLinks          SubjectExamCycleLink[]
  questionBanks         QuestionBank[]

  @@unique([academicYear, semester, examType])
  @@index([status, departmentId])
  @@index([departmentId])
}

model Subject {
  id                  String         @id @default(cuid())
  subjectCode         String
  subjectName         String
  academicYear        String
  semester            Int
  credits             Int
  status              SubjectStatus  @default(ACTIVE)
  questionBankDueDate DateTime
  departmentId        String
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  department          Department     @relation(fields: [departmentId], references: [id])
  examCycleLinks      SubjectExamCycleLink[]
  questionBanks       QuestionBank[]

  @@unique([subjectCode, departmentId])
  @@index([departmentId])
  @@index([semester])
}

model QuestionBank {
  id           String              @id @default(cuid())
  subjectId    String
  examCycleId  String
  status       QuestionBankStatus  @default(DRAFT)
  version      Int                 @default(0)
  createdById  String
  lockedAt     DateTime?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  subject      Subject             @relation(fields: [subjectId], references: [id])
  examCycle    ExamCycle           @relation(fields: [examCycleId], references: [id])
  createdBy    User                @relation("questionBankCreator", fields: [createdById], references: [id])
  assignments  TeacherAssignment[]
  moderatorAssignments ModeratorBankAssignment[]
  questionSlots QuestionSlot[]
  questions    Question[]
  aiReports    AiReport[]
  generatedPapers GeneratedPaper[]
  deanReview   DeanReview?
  signedReportAssetId String?
  signedReportUploadedAt DateTime?
  coordinatorDecision CoordinatorDecision?
  coordinatorReviewedAt DateTime?
  coordinatorReviewRemark String?
  signedReportAsset FileAsset? @relation("questionBankSignedReport", fields: [signedReportAssetId], references: [id])
  exportArtifacts ExportArtifact[]

  @@unique([subjectId, examCycleId])
  @@index([status])
  @@index([subjectId])
}

model TeacherAssignment {
  id             String         @id @default(cuid())
  questionBankId String
  teacherId      String
  assignmentRole AssignmentRole
  moduleNumber   Int?
  assignedById   String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  questionBank   QuestionBank   @relation(fields: [questionBankId], references: [id])
  teacher        User           @relation("assignedTeacher", fields: [teacherId], references: [id])
  assignedBy     User           @relation("assignedBy", fields: [assignedById], references: [id])

  @@unique([questionBankId, teacherId, assignmentRole, moduleNumber])
  @@index([teacherId])
}

model CoordinatorDepartmentAssignment {
  id           String     @id @default(cuid())
  coordinatorId String
  departmentId String
  assignedAt   DateTime   @default(now())
  coordinator  User       @relation("coordinatorDepartmentUser", fields: [coordinatorId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([coordinatorId, departmentId])
}

model SubjectExamCycleLink {
  id          String    @id @default(cuid())
  subjectId    String
  examCycleId  String
  linkedAt    DateTime  @default(now())
  subject      Subject   @relation(fields: [subjectId], references: [id])
  examCycle    ExamCycle @relation(fields: [examCycleId], references: [id])

  @@unique([subjectId, examCycleId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean          @default(false)
  actionUrl   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  recipient   User             @relation(fields: [recipientId], references: [id])

  @@index([recipientId, isRead, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  previousHash String?
  integrityHash String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
}

model FileAsset {
  id               String   @id @default(cuid())
  bucket           String
  objectKey        String   @unique
  fileName         String
  mimeType         String
  size             Int
  uploadedById     String?
  linkedEntityType String?
  linkedEntityId   String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  attachments      QuestionAttachment[]
  aiReportsJson    AiReport[]      @relation("aiReportJsonAsset")
  aiReportsPdf     AiReport[]      @relation("aiReportPdfAsset")
  generatedPaperFiles GeneratedPaper[] @relation("generatedPaperFileAsset")
  signedQuestionBanks QuestionBank[] @relation("questionBankSignedReport")
  exportArtifacts ExportArtifact[] @relation("exportArtifactFileAsset")
  systemBackups   SystemBackup[]   @relation("systemBackupFileAsset")
}

model QuestionSlot {
  id              String       @id @default(cuid())
  questionBankId  String
  moduleNumber    Int
  marks           Int
  slotNumber      Int
  version         Int          @default(0)
  reservedById    String?
  reservedAt      DateTime?
  isLocked        Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  questionBank    QuestionBank @relation(fields: [questionBankId], references: [id])
  reservedBy      User?        @relation("slotReservedBy", fields: [reservedById], references: [id])
  question        Question?

  @@unique([questionBankId, moduleNumber, marks, slotNumber])
}

model Question {
  id              String           @id @default(cuid())
  questionBankId  String
  slotId          String?          @unique
  version         Int              @default(0)
  questionText    String
  moduleNumber    Int
  marks           Int
  slotNumber      Int
  coMapping       CourseOutcome
  rbtLevel        RbtLevel
  teachingIndex   String?
  difficultyLevel DifficultyLevel?
  contributorId   String
  status          QuestionStatus   @default(DRAFT)
  moderatorRemark String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  usageCount      Int              @default(0)
  lastUsedExam    String?
  lastUsedYear    String?
  lastUsedSemester Int?
  lastUsedType    ExamType?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  questionBank    QuestionBank     @relation(fields: [questionBankId], references: [id])
  slot            QuestionSlot?    @relation(fields: [slotId], references: [id])
  contributor     User             @relation("questionContributor", fields: [contributorId], references: [id])
  moderationEvents ModerationEvent[]
  revisions       QuestionRevision[]
  attachments     QuestionAttachment[]
  generatedPaperItems GeneratedPaperItem[]

  @@index([questionBankId, moduleNumber, marks, slotNumber])
  @@index([contributorId, status])
  @@index([status])
}

model QuestionAttachment {
  id           String    @id @default(cuid())
  questionId   String
  fileAssetId  String
  uploadedById String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  question     Question   @relation(fields: [questionId], references: [id])
  fileAsset    FileAsset  @relation(fields: [fileAssetId], references: [id])
  uploadedBy   User       @relation("attachmentUploader", fields: [uploadedById], references: [id])

  @@unique([questionId, fileAssetId])
}

model ModerationEvent {
  id          String   @id @default(cuid())
  questionId  String
  moderatorId String
  action      String
  note        String?
  createdAt   DateTime @default(now())
  question    Question @relation(fields: [questionId], references: [id])
  moderator   User     @relation("moderationEventActor", fields: [moderatorId], references: [id])

  @@index([questionId, createdAt])
  @@index([moderatorId, createdAt])
}

model QuestionRevision {
  id               String   @id @default(cuid())
  questionId       String
  versionNumber    Int
  questionText     String
  submittedById    String
  submittedAt      DateTime
  moderatorComment String?
  question         Question @relation(fields: [questionId], references: [id])
  submittedBy      User     @relation("revisionSubmitter", fields: [submittedById], references: [id])

  @@unique([questionId, versionNumber])
  @@index([questionId, submittedAt])
}

model ModeratorBankAssignment {
  id             String       @id @default(cuid())
  moderatorId    String
  questionBankId String
  assignedAt     DateTime     @default(now())
  moderator      User         @relation("moderatorBankUser", fields: [moderatorId], references: [id])
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id])

  @@unique([moderatorId, questionBankId])
}

model AiReport {
  id                 String          @id @default(cuid())
  questionBankId     String
  status             AiReportStatus  @default(PENDING)
  modelName          String
  summary            String?
  reportJson         Json?
  chartData          Json?
  failureReason      String?
  generatedById      String?
  generatedAt        DateTime?
  jsonFileAssetId    String?
  pdfFileAssetId     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  questionBank       QuestionBank    @relation(fields: [questionBankId], references: [id])
  jsonFileAsset      FileAsset?      @relation("aiReportJsonAsset", fields: [jsonFileAssetId], references: [id])
  pdfFileAsset       FileAsset?      @relation("aiReportPdfAsset", fields: [pdfFileAssetId], references: [id])

  @@index([questionBankId, status])
}

model GeneratedPaper {
  id                String                 @id @default(cuid())
  questionBankId    String
  variant           PaperVariant
  status            PaperGenerationStatus  @default(PENDING)
  generatedById     String?
  generatedAt       DateTime?
  failureReason     String?
  paperJson         Json?
  paperFileAssetId  String?
  coverageScore     Float?
  difficultyScore   Float?
  qualityScore      Float?
  duplicateRisk     Float?
  recommendation    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  questionBank      QuestionBank           @relation(fields: [questionBankId], references: [id])
  paperFileAsset    FileAsset?             @relation("generatedPaperFileAsset", fields: [paperFileAssetId], references: [id])
  items             GeneratedPaperItem[]

  @@unique([questionBankId, variant])
}

model GeneratedPaperItem {
  id                String         @id @default(cuid())
  generatedPaperId  String
  questionId        String
  createdAt         DateTime       @default(now())
  generatedPaper    GeneratedPaper @relation(fields: [generatedPaperId], references: [id])
  question          Question       @relation(fields: [questionId], references: [id])

  @@unique([generatedPaperId, questionId])
}

model DeanReview {
  id                 String       @id @default(cuid())
  questionBankId     String       @unique
  regularPaper       PaperVariant @map("regularPaperId")
  supplementaryPaper PaperVariant @map("supplementaryPaperId")
  ktPaper            PaperVariant @map("ktPaperId")
  reviewedById       String       @map("selectedById")
  notes              String?
  reviewedAt         DateTime     @default(now()) @map("selectedAt")
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  questionBank       QuestionBank @relation(fields: [questionBankId], references: [id])
  reviewedBy         User         @relation("deanReviewSelector", fields: [reviewedById], references: [id])
}

model ExportArtifact {
  id             String               @id @default(cuid())
  questionBankId String
  generatedById  String?
  format         ExportFormat
  status         ExportArtifactStatus @default(PENDING)
  fileAssetId    String?
  metadata       Json?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  questionBank   QuestionBank         @relation(fields: [questionBankId], references: [id])
  generatedBy    User?                @relation("exportArtifactGenerator", fields: [generatedById], references: [id])
  fileAsset      FileAsset?           @relation("exportArtifactFileAsset", fields: [fileAssetId], references: [id])

  @@index([questionBankId, format, status])
}

model SystemBackup {
  id            String       @id @default(cuid())
  status        BackupStatus @default(PENDING)
  fileAssetId   String?
  triggeredById String?
  metadata      Json?
  failureReason String?
  expiresAt     DateTime
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  fileAsset     FileAsset?   @relation("systemBackupFileAsset", fields: [fileAssetId], references: [id])
  triggeredBy   User?        @relation("backupTrigger", fields: [triggeredById], references: [id])
}
