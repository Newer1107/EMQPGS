generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  COE
  COORDINATOR
  MODERATOR
  CONTRIBUTOR
  DEAN
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum SubjectStatus {
  ACTIVE
  INACTIVE
}

enum ExamType {
  ISE_1
  ISE_2
  ENDSEM
  SUPPLEMENTARY
  KT
}

enum ExamCycleStatus {
  DRAFT
  ACTIVE
  CLOSED
}

enum QuestionBankPhase {
  DRAFTING
  MODERATION
  APPROVAL
  COMPLETE
}

enum RecordStatus {
  ACTIVE
  LOCKED
  ARCHIVED
}

enum ReviewStatus {
  PENDING
  SUBMITTED
  CONFIRMED
}

enum SnapshotType {
  LOCKED
  APPROVED
  EXPORTED
}

enum AiReportStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaperGenerationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum PaperVariant {
  PAPER_A
  PAPER_B
  PAPER_C
}

enum CoordinatorDecision {
  APPROVED
  REJECTED
}

enum ExportFormat {
  PDF
  DOCX
  ZIP
}

enum ExportArtifactStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum BackupStatus {
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

enum NotificationType {
  INFO
  SUCCESS
  WARNING
  ACTION_REQUIRED
}

enum CourseOutcome {
  CO1
  CO2
  CO3
  CO4
  CO5
  CO6
}

enum RbtLevel {
  L1
  L2
  L3
  L4
  L5
  L6
}

enum DifficultyLevel {
  EASY
  MEDIUM
  HARD
}

enum QuestionStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  REVISION_REQUESTED
  REVISION_SUBMITTED
}

enum SemesterType {
  ODD
  EVEN
}

enum AcademicYearStatus {
  ACTIVE
  CLOSED
}

enum SubjectVersionStatus {
  ACTIVE
  ARCHIVED
}

model AcademicYear {
  id                 String            @id @default(cuid())
  code               String            @unique
  startDate          DateTime
  endDate            DateTime
  status             AcademicYearStatus @default(ACTIVE)
  activeSemesterType SemesterType       @default(ODD)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  semesters          Semester[]
  examCycles         ExamCycle[]
  subjectVersions    SubjectVersion[]  @relation("subjectVersionAcademicYear")
}

model Semester {
  id            String        @id @default(cuid())
  number        Int
  name          String
  academicYearId String
  academicYear  AcademicYear  @relation(fields: [academicYearId], references: [id])
  examCycles    ExamCycle[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([academicYearId, number])
  @@index([academicYearId])
}

model SubjectVersion {
  id                         String                @id @default(cuid())
  subjectId                  String
  versionNumber              Int
  title                      String
  syllabusDescription        String?
  effectiveFromAcademicYearId String
  status                     SubjectVersionStatus  @default(ACTIVE)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  subject                    Subject               @relation(fields: [subjectId], references: [id])
  effectiveFromAcademicYear  AcademicYear          @relation("subjectVersionAcademicYear", fields: [effectiveFromAcademicYearId], references: [id])
  libraryItems               QuestionLibraryItem[]

  @@unique([subjectId, versionNumber])
  @@index([subjectId, status])
}

model Department {
  id           String    @id @default(cuid())
  name         String
  code         String    @unique
  hodName      String
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  users        User[]
  coordinatorAssignments CoordinatorDepartmentAssignment[]
  subjects     Subject[]
  examCycles   ExamCycle[]
}

model User {
  id               String              @id @default(cuid())
  name             String
  email            String              @unique
  passwordHash     String
  role             Role
  status           UserStatus          @default(ACTIVE)
  lastLoginAt      DateTime?
  departmentId     String?
  resetTokenHash   String?
  resetTokenExpiry DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  department       Department?         @relation(fields: [departmentId], references: [id])
  coordinatorDepartments CoordinatorDepartmentAssignment[] @relation("coordinatorDepartmentUser")
  moderatorBankAssignments ModeratorBankAssignment[] @relation("moderatorBankUser")
  notifications    Notification[]
  auditLogs        AuditLog[]
  questionBanks    QuestionBank[]      @relation("questionBankCreator")
  createdQuestions  QuestionLibraryItem[] @relation("questionCreator")
  ownedQuestions    QuestionLibraryItem[] @relation("questionOwner")
  moderationEvents ModerationEvent[]   @relation("moderationEventActor")
  revisionChanges   QuestionRevision[]   @relation("revisionChangedBy")
  ownershipToUser   QuestionOwnershipHistory[] @relation("ownershipToUser")
  ownershipFromUser QuestionOwnershipHistory[] @relation("ownershipFromUser")
  ownershipTransferredBy QuestionOwnershipHistory[] @relation("ownershipTransferredBy")
  deanReviews      DeanReview[]        @relation("deanReviewSelector")
  slotReservations QuestionSlot[]
  approvalDecisionsCreated ApprovalDecision[]
  exportArtifacts  ExportArtifact[]    @relation("exportArtifactGenerator")
  backupsTriggered SystemBackup[]      @relation("backupTrigger")

  @@index([role])
  @@index([departmentId])
}

model ExamCycle {
  id                    String            @id @default(cuid())
  examType              ExamType
  status                ExamCycleStatus   @default(DRAFT)
  version               Int               @default(0)
  startDate             DateTime?
  endDate               DateTime?
  departmentId          String
  academicYearId        String
  semesterId            String
  timetableDocumentRef  String?
  timetableIssueDate    DateTime?
  timetableTitle        String?

  timetableRows         Json?
  timetableSignature    String?
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
  department            Department        @relation(fields: [departmentId], references: [id])
  academicYear          AcademicYear      @relation(fields: [academicYearId], references: [id])
  semester              Semester          @relation(fields: [semesterId], references: [id])
  subjectLinks          SubjectExamCycleLink[]
  questionBanks         QuestionBank[]
  questionUsageHistory  QuestionUsageHistory[] @relation("usageHistoryExamCycle")

  @@unique([semesterId, examType, departmentId])
  @@index([status, departmentId])
  @@index([departmentId])
  @@index([academicYearId])
  @@index([semesterId])
}

model Subject {
  id                  String         @id @default(cuid())
  subjectCode         String
  subjectName         String
  credits             Int
  status              SubjectStatus  @default(ACTIVE)
  questionBankDueDate DateTime
  departmentId        String
  semesterNumber      Int
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  department          Department     @relation(fields: [departmentId], references: [id])
  examCycleLinks      SubjectExamCycleLink[]
  questionBanks       QuestionBank[]
  versions            SubjectVersion[]

  @@unique([subjectCode, departmentId])
  @@index([departmentId])
}

model QuestionBank {
  id           String              @id @default(cuid())
  subjectId    String
  examCycleId  String
  phase        QuestionBankPhase   @default(DRAFTING)
  recordStatus RecordStatus        @default(ACTIVE)
  version      Int                 @default(0)
  createdById  String
  lockedAt     DateTime?
  lockedReason String?
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  subject      Subject             @relation(fields: [subjectId], references: [id])
  examCycle    ExamCycle           @relation(fields: [examCycleId], references: [id])
  createdBy    User                @relation("questionBankCreator", fields: [createdById], references: [id])
  moderatorAssignments ModeratorBankAssignment[]
  aiReports    AiReport[]
  generatedPapers GeneratedPaper[]
  deanReview   DeanReview?
  exportArtifacts ExportArtifact[]

  slots         QuestionSlot[]
  pattern       PaperPattern?
  snapshots     QuestionBankSnapshot[]
  paperSnapshots PaperSnapshot[]
  approvalDecisions ApprovalDecision[]

  @@unique([subjectId, examCycleId])
  @@index([subjectId])
  @@index([phase, recordStatus])
}

model QuestionLibraryItem {
  id              String          @id @default(cuid())
  subjectVersionId String
  moduleNumber    Int
  marks           Int
  questionText    String
  coMapping       CourseOutcome
  rbtLevel        RbtLevel
  difficultyLevel DifficultyLevel?
  teachingIndex   String?
  status          QuestionStatus  @default(DRAFT)
  createdById     String
  ownerId         String
  moderatorRemark String?
  submittedAt     DateTime?
  reviewedAt      DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  subjectVersion  SubjectVersion  @relation(fields: [subjectVersionId], references: [id])
  creator         User            @relation("questionCreator", fields: [createdById], references: [id])
  owner           User            @relation("questionOwner", fields: [ownerId], references: [id])
  moderationEvents ModerationEvent[]
  generatedPaperItems GeneratedPaperItem[]
  revisionHistory QuestionRevision[]
  slotAssignments QuestionSlot[]
  ownershipHistory QuestionOwnershipHistory[]
  usageHistory    QuestionUsageHistory[]

  @@index([subjectVersionId, moduleNumber, marks])
  @@index([createdById, status])
  @@index([ownerId])
  @@index([status])
}

model QuestionOwnershipHistory {
  id             String             @id @default(cuid())
  questionId     String
  fromUserId     String
  toUserId       String
  transferredById String
  reason         String?
  transferredAt  DateTime           @default(now())
  question       QuestionLibraryItem @relation(fields: [questionId], references: [id])
  fromUser       User              @relation("ownershipFromUser", fields: [fromUserId], references: [id])
  toUser         User               @relation("ownershipToUser", fields: [toUserId], references: [id])
  transferredBy  User               @relation("ownershipTransferredBy", fields: [transferredById], references: [id])

  @@index([questionId, transferredAt])
}

model QuestionRevision {
  id               String             @id @default(cuid())
  questionId       String
  revisionNumber   Int
  snapshotQuestionText String
  snapshotModule   Int
  snapshotMarks    Int
  snapshotCo       CourseOutcome
  snapshotRbt      RbtLevel
  snapshotDifficulty DifficultyLevel?
  snapshotTeachingIndex String?
  changedById      String
  changeReason     String?
  createdAt        DateTime           @default(now())
  question         QuestionLibraryItem @relation(fields: [questionId], references: [id])
  changedBy        User               @relation("revisionChangedBy", fields: [changedById], references: [id])

  @@unique([questionId, revisionNumber])
  @@index([questionId, createdAt])
}

model QuestionUsageHistory {
  id                   String             @id @default(cuid())
  questionId           String
  sourceType           String             // "GENERATED_PAPER" | "MANUAL" | "EXPORT"
  sourceId             String
  examCycleId          String?
  usedAt               DateTime           @default(now())
  question             QuestionLibraryItem @relation(fields: [questionId], references: [id])
  examCycle            ExamCycle?         @relation("usageHistoryExamCycle", fields: [examCycleId], references: [id])

  @@index([questionId, usedAt])
  @@index([sourceType, sourceId])
}

// A QuestionSlot links a QuestionLibraryItem to a specific position within a QuestionBank.
// A QuestionLibraryItem MAY be assigned to slots in multiple different banks simultaneously,
// but within a single bank it can only occupy ONE slot (enforced at the application layer).
// The slot's composite unique key (bank + module + marks + slotNumber) defines the position.
model QuestionSlot {
  id                 String               @id @default(cuid())
  questionBankId     String
  moduleNumber       Int
  marks              Int
  slotNumber         Int
  assignedQuestionId String?
  reservedById       String?
  reservedAt         DateTime?
  isLocked           Boolean              @default(false)

  questionBank       QuestionBank         @relation(fields: [questionBankId], references: [id])
  assignedQuestion   QuestionLibraryItem? @relation(fields: [assignedQuestionId], references: [id])
  reservedBy         User?                @relation(fields: [reservedById], references: [id])

  @@unique([questionBankId, moduleNumber, marks, slotNumber])
  @@index([questionBankId, assignedQuestionId])
  @@index([assignedQuestionId])
}

model PaperPattern {
  id              String       @id @default(cuid())
  questionBankId  String       @unique
  examType        ExamType
  totalModules    Int
  marksPattern    Json
  slotsPerModule  Int
  totalSlots      Int
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  questionBank    QuestionBank @relation(fields: [questionBankId], references: [id])
}

model ApprovalDecision {
  id              String              @id @default(cuid())
  questionBankId  String
  decision        CoordinatorDecision
  remark          String?
  decidedById     String
  decidedAt       DateTime            @default(now())

  questionBank    QuestionBank        @relation(fields: [questionBankId], references: [id])
  decidedBy       User                @relation(fields: [decidedById], references: [id])

  @@index([questionBankId])
}

model QuestionBankSnapshot {
  id              String             @id @default(cuid())
  questionBankId  String
  snapshotType    SnapshotType
  phase           QuestionBankPhase
  status          RecordStatus
  slotAssignments Json
  paperAssignments Json?
  metadata        Json?
  version         Int
  createdAt       DateTime           @default(now())

  questionBank    QuestionBank       @relation(fields: [questionBankId], references: [id])

  @@index([questionBankId, snapshotType, createdAt])
}

model PaperSnapshot {
  id              String       @id @default(cuid())
  questionBankId  String
  variant         PaperVariant
  paperJson       Json
  coverageScore   Float?
  difficultyScore Float?
  qualityScore    Float?
  metadata        Json?
  createdAt       DateTime     @default(now())

  questionBank    QuestionBank @relation(fields: [questionBankId], references: [id])

  @@unique([questionBankId, variant])
}

model CoordinatorDepartmentAssignment {
  id           String     @id @default(cuid())
  coordinatorId String
  departmentId String
  assignedAt   DateTime   @default(now())
  coordinator  User       @relation("coordinatorDepartmentUser", fields: [coordinatorId], references: [id])
  department   Department @relation(fields: [departmentId], references: [id])

  @@unique([coordinatorId, departmentId])
}

model SubjectExamCycleLink {
  id          String    @id @default(cuid())
  subjectId    String
  examCycleId  String
  linkedAt    DateTime  @default(now())
  subject      Subject   @relation(fields: [subjectId], references: [id])
  examCycle    ExamCycle @relation(fields: [examCycleId], references: [id])

  @@unique([subjectId, examCycleId])
}

model Notification {
  id          String           @id @default(cuid())
  recipientId String
  title       String
  message     String
  type        NotificationType @default(INFO)
  isRead      Boolean          @default(false)
  actionUrl   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  recipient   User             @relation(fields: [recipientId], references: [id])

  @@index([recipientId, isRead, createdAt])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  previousHash String?
  integrityHash String?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorId], references: [id])

  @@index([entityType, entityId, createdAt])
  @@index([actorId])
}

model FileAsset {
  id               String   @id @default(cuid())
  bucket           String
  objectKey        String   @unique
  fileName         String
  mimeType         String
  size             Int
  uploadedById     String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  aiReportsJson    AiReport[]      @relation("aiReportJsonAsset")
  aiReportsPdf     AiReport[]      @relation("aiReportPdfAsset")
  generatedPaperFiles GeneratedPaper[] @relation("generatedPaperFileAsset")
  exportArtifacts ExportArtifact[] @relation("exportArtifactFileAsset")
  systemBackups   SystemBackup[]   @relation("systemBackupFileAsset")
}

model ModerationEvent {
  id          String   @id @default(cuid())
  questionId  String
  moderatorId String
  action      String
  note        String?
  createdAt   DateTime @default(now())
  question    QuestionLibraryItem @relation(fields: [questionId], references: [id])
  moderator   User     @relation("moderationEventActor", fields: [moderatorId], references: [id])

  @@index([questionId, createdAt])
  @@index([moderatorId, createdAt])
}

model ModeratorBankAssignment {
  id             String       @id @default(cuid())
  moderatorId    String
  questionBankId String
  assignedAt     DateTime     @default(now())
  moderator      User         @relation("moderatorBankUser", fields: [moderatorId], references: [id])
  questionBank   QuestionBank @relation(fields: [questionBankId], references: [id])

  @@unique([moderatorId, questionBankId])
}

model AiReport {
  id                 String          @id @default(cuid())
  questionBankId     String
  status             AiReportStatus  @default(PENDING)
  modelName          String
  summary            String?
  reportJson         Json?
  chartData          Json?
  failureReason      String?
  generatedById      String?
  generatedAt        DateTime?
  jsonFileAssetId    String?
  pdfFileAssetId     String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  questionBank       QuestionBank    @relation(fields: [questionBankId], references: [id])
  jsonFileAsset      FileAsset?      @relation("aiReportJsonAsset", fields: [jsonFileAssetId], references: [id])
  pdfFileAsset       FileAsset?      @relation("aiReportPdfAsset", fields: [pdfFileAssetId], references: [id])

  @@index([questionBankId, status])
}

model GeneratedPaper {
  id                String                 @id @default(cuid())
  questionBankId    String
  variant           PaperVariant
  status            PaperGenerationStatus  @default(PENDING)
  generatedById     String?
  generatedAt       DateTime?
  failureReason     String?
  paperJson         Json?
  paperFileAssetId  String?
  coverageScore     Float?
  difficultyScore   Float?
  qualityScore      Float?
  duplicateRisk     Float?
  recommendation    String?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  questionBank      QuestionBank           @relation(fields: [questionBankId], references: [id])
  paperFileAsset    FileAsset?             @relation("generatedPaperFileAsset", fields: [paperFileAssetId], references: [id])
  items             GeneratedPaperItem[]

  @@unique([questionBankId, variant])
}

model GeneratedPaperItem {
  id                String         @id @default(cuid())
  generatedPaperId  String
  questionId        String
  createdAt         DateTime       @default(now())
  generatedPaper      GeneratedPaper @relation(fields: [generatedPaperId], references: [id])
  question            QuestionLibraryItem @relation(fields: [questionId], references: [id])

  @@unique([generatedPaperId, questionId])
}

model DeanReview {
  id                 String       @id @default(cuid())
  questionBankId     String       @unique
  regularPaper       PaperVariant
  supplementaryPaper PaperVariant
  ktPaper            PaperVariant
  reviewedById       String
  notes              String?
  reviewedAt         DateTime     @default(now())
  status             ReviewStatus @default(PENDING)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  questionBank       QuestionBank @relation(fields: [questionBankId], references: [id])
  reviewedBy         User         @relation("deanReviewSelector", fields: [reviewedById], references: [id])
}

model ExportArtifact {
  id             String               @id @default(cuid())
  questionBankId String
  generatedById  String?
  format         ExportFormat
  status         ExportArtifactStatus @default(PENDING)
  fileAssetId    String?
  metadata       Json?
  expiresAt      DateTime
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  questionBank   QuestionBank         @relation(fields: [questionBankId], references: [id])
  generatedBy    User?                @relation("exportArtifactGenerator", fields: [generatedById], references: [id])
  fileAsset      FileAsset?           @relation("exportArtifactFileAsset", fields: [fileAssetId], references: [id])

  @@index([questionBankId, format, status])
}

model SystemBackup {
  id            String       @id @default(cuid())
  status        BackupStatus @default(PENDING)
  fileAssetId   String?
  triggeredById String?
  metadata      Json?
  failureReason String?
  expiresAt     DateTime
  startedAt     DateTime     @default(now())
  completedAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  fileAsset     FileAsset?   @relation("systemBackupFileAsset", fields: [fileAssetId], references: [id])
  triggeredBy   User?        @relation("backupTrigger", fields: [triggeredById], references: [id])
}
